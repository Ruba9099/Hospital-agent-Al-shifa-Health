# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# LLM / AI provider
LLM_API_KEY=your-api-key-here
LLM_MODEL=your-model-name

# Speech (if using a cloud STT/TTS service)
SPEECH_API_KEY=your-speech-api-key

# App
PORT=8080
DEFAULT_LANGUAGE=en          # en | ur

# Emergency escalation (where urgent cases are sent)
ESCALATION_PHONE=+92XXXXXXXXXX
ESCALATION_EMAIL=frontdesk@example.com
